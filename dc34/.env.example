# Copy this file to .env and fill in your values.

# Robot brain — see README.md "Robot brain setup" for concrete configs.
BRAIN_BACKEND=openai
BRAIN_BASE_URL=http://host.docker.internal:11434/v1
BRAIN_MODEL=gemma4:e4b
BRAIN_API_KEY=

# Team token — the bearer token the game API expects. Change it if you like;
# "team-demo" is the default the challenges/docs assume.
TEAM_TOKEN=team-demo
